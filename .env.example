# ---------------------------------------------------------------------------
# RackMon configuration. Copy to .env and edit.  Never commit a real .env.
#
# Every application setting takes the RACKMON_ prefix and is read by
# backend/app/config.py, which is the authoritative list. Everything below is
# shown with its real default, commented out — uncomment only what you change.
# The handful of lines that are NOT commented out are the ones worth setting on
# any real install.
# ---------------------------------------------------------------------------

# === Required ==============================================================
# Generate each of these with:  openssl rand -hex 32
# Losing MASTER_KEY means re-entering every stored SNMP and LDAP credential.
RACKMON_JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
RACKMON_MASTER_KEY=changeme-generate-with-openssl-rand-hex-32

# "production" makes RackMon REFUSE TO START on a factory secret instead of
# warning and carrying on. Default is "development". Set it.
RACKMON_ENVIRONMENT=production

# The first administrator, created only when the installation has no
# administrator at all. Set both; the defaults are published.
RACKMON_ADMIN_EMAIL=you@example.com
RACKMON_ADMIN_PASSWORD=changeme-use-a-long-random-password

# === Database ==============================================================
# SQLite needs nothing else running and is fine to start:
#   RACKMON_DATABASE_URL=sqlite:////data/rackmon.db
# PostgreSQL/TimescaleDB is the path once history grows:
RACKMON_DATABASE_URL=postgresql+psycopg2://rackmon:rackmon@db:5432/rackmon

# === Where this instance is reachable ======================================
# Used to build links in notifications and reports.
RACKMON_PUBLIC_BASE_URL=http://localhost:8080

# === Used by docker-compose.yml, not by the application ====================
DB_PASSWORD=change-me-strong-db-password
HTTP_PORT=8080

# === General ===============================================================
# RACKMON_LOG_LEVEL=INFO
# Serve /docs and /redoc. Off by default; they expose the full API surface.
# RACKMON_API_DOCS_ENABLED=false
# Bearer token guarding /metrics (Prometheus). Empty = endpoint disabled.
# RACKMON_METRICS_TOKEN=
# Browser origins allowed to call the API. Only needed for a separate frontend.
# RACKMON_CORS_ORIGINS=["http://localhost:5173"]

# === Sessions & login hardening ============================================
# How session tokens are signed. There is no reason to change this, and a
# value the library does not know makes every login fail.
# RACKMON_JWT_ALGORITHM=HS256
# RACKMON_ACCESS_TOKEN_TTL_MINUTES=30
# RACKMON_REFRESH_TOKEN_TTL_DAYS=7
# RACKMON_PASSWORD_MIN_LENGTH=8
# RACKMON_MAX_LOGIN_ATTEMPTS=5
# RACKMON_LOCKOUT_SECONDS=300

# === Polling ===============================================================
# RACKMON_POLLER_ENABLED=true
# RACKMON_POLLER_TICK_SECONDS=3.0
# RACKMON_SNMP_TIMEOUT_SECONDS=2.0
# RACKMON_SNMP_RETRIES=2
# true = generate realistic fake telemetry so you can look around before wiring
# up hardware. Set false to poll real devices over SNMP.
RACKMON_POLLER_USE_SIMULATOR=true
# Redis fans live telemetry out across several instances. Empty = single node.
# RACKMON_REDIS_URL=

# === Retention =============================================================
# How long raw points are kept, and how often the sweep runs.
# RACKMON_RAW_RETENTION_DAYS=30
# RACKMON_RETENTION_SWEEP_MINUTES=60

# === Email (SMTP) ==========================================================
# Without a host, alerts are recorded and shown in the UI but never leave the
# machine. This is the single most common reason an install stays silent.
# RACKMON_SMTP_HOST=
# RACKMON_SMTP_PORT=587
# RACKMON_SMTP_USER=
# RACKMON_SMTP_PASSWORD=
# RACKMON_SMTP_USE_TLS=true
# RACKMON_SMTP_USE_SSL=false
# RACKMON_SMTP_FROM=rackmon@localhost
# RACKMON_ALERT_DEFAULT_RECIPIENTS=["oncall@example.com"]

# === Other notification channels (all optional) ============================
# Any you set are used in addition to email.
# RACKMON_ALERT_WEBHOOK_URL=https://your-endpoint.example/ingest
# RACKMON_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# RACKMON_TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/XXX
# RACKMON_TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# RACKMON_TELEGRAM_CHAT_ID=-1001234567890

# === Alert escalation ======================================================
# Re-notify a different list if nobody acknowledges in time.
# RACKMON_ESCALATION_ENABLED=false
# RACKMON_ESCALATE_AFTER_SECONDS=900
# RACKMON_ESCALATION_RECIPIENTS=["manager@example.com"]

# === Scheduled reports =====================================================
# RACKMON_REPORT_WEEKLY_ENABLED=false
# RACKMON_REPORT_WEEKLY_RECIPIENTS=["ops@example.com"]

# === LDAP / Active Directory ===============================================
# Included, like everything else. For Active Directory the usual filter is
# (sAMAccountName={username}); the default below suits OpenLDAP.
# RACKMON_LDAP_ENABLED=false
# RACKMON_LDAP_SERVER_URI=ldaps://dc01.example.local:636
# RACKMON_LDAP_BIND_DN=CN=svc_rackmon,OU=Service,DC=example,DC=local
# RACKMON_LDAP_BIND_PASSWORD=
# RACKMON_LDAP_USER_BASE_DN=OU=Users,DC=example,DC=local
# RACKMON_LDAP_USER_FILTER=(uid={username})
# RACKMON_LDAP_EMAIL_ATTR=mail
# RACKMON_LDAP_GROUP_ATTR=memberOf
# RACKMON_LDAP_ADMIN_GROUP=CN=RackMonAdmins,OU=Groups,DC=example,DC=local
# RACKMON_LDAP_DEFAULT_ROLE=viewer

# === Single sign-on (OpenID Connect) =======================================
# The authorization, token and JWKS endpoints are discovered from the issuer
# unless you set them. ID-token signatures are verified against the JWKS.
# RACKMON_OIDC_ENABLED=false
# RACKMON_OIDC_ISSUER=https://login.example.com
# RACKMON_OIDC_CLIENT_ID=
# RACKMON_OIDC_CLIENT_SECRET=
# RACKMON_OIDC_REDIRECT_URI=https://rackmon.example.com/api/v1/auth/oidc/callback
# RACKMON_OIDC_AUTHORIZATION_ENDPOINT=
# RACKMON_OIDC_TOKEN_ENDPOINT=
# RACKMON_OIDC_JWKS_URI=
# RACKMON_OIDC_SCOPES=openid email profile
# RACKMON_OIDC_DEFAULT_ROLE=viewer
# RACKMON_OIDC_ADMIN_EMAILS=["you@example.com"]

# === SNMP trap receiver ====================================================
# Off by default; port 162 needs privileges, so map a high port if unprivileged.
# RACKMON_SNMP_TRAP_ENABLED=false
# RACKMON_SNMP_TRAP_PORT=162
# RACKMON_SNMP_TRAP_COMMUNITY=public

# === Update check ==========================================================
# Off by default. When on, a plain GET of a public JSON file. Nothing about
# your install is sent. Leave the URL empty to use the project's own.
# RACKMON_UPDATE_CHECK_ENABLED=false
# RACKMON_UPDATE_MANIFEST_URL=

# === In-app support form ===================================================
# Only sends when a human clicks send. INSTANCE_ID is a label you choose so two
# messages from the same install can be matched up; empty uses the base URL.
# RACKMON_SUPPORT_URL=https://rackmon.app/support/messages
# RACKMON_INSTANCE_ID=

# === Plugins ===============================================================
# Importable module paths loaded at startup; see backend/app/plugins/examples.
# RACKMON_PLUGINS_MODULES=["app.plugins.examples.pagerduty"]

# === Seed data =============================================================
# Seeds example racks and devices on an EMPTY database. Turn off for real use.
RACKMON_SEED_DEMO_DATA=true
# An extra read-only account, created only if you give it a password of your
# own. Left unset, it is not created at all.
# RACKMON_VIEWER_EMAIL=viewer@example.com
# RACKMON_VIEWER_PASSWORD=

# === Public demo only ======================================================
# Puts a "sign in as the demo user" button on the login screen. This exists for
# demo.rackmon.app. Do not turn it on anywhere else.
# RACKMON_DEMO_MODE=false
# RACKMON_DEMO_USER_EMAIL=

# === Retired ===============================================================
# RackMon was open-core until 1 November 2026. From 1.3.0 every feature is
# included and this value is read and ignored, so an old .env still starts.
# RACKMON_LICENSE_KEY=
